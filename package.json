{
  "name": "gh-telegram-stars-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Telegram bot that notifies subscribers about new stars on GitHub repositories. Runs on Cloudflare Workers with D1.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "wrangler dev",
    "dev:scheduled": "wrangler dev --test-scheduled",
    "typegen": "wrangler types",
    "typecheck": "tsc -p . && tsc -p test && tsc -p tsconfig.tools.json && tsc -p scripts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typegen:check": "wrangler types --check",
    "telegram:setup": "node scripts/telegram-setup.ts",
    "migrate:copy": "node scripts/copy-to-d1.ts",
    "migrate:verify": "node scripts/verify-copy.ts",
    "migrate:copy-back": "node scripts/copy-back-to-supabase.ts",
    "shadow:compare": "node scripts/compare-shadow.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-istanbul": "4.1.12",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "dependencies": {
    "grammy": "1.46.0",
    "zod": "4.6.7"
  }
}
